# Octopus environment template

NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

POSTGRES_USER=octopus
POSTGRES_PASSWORD=octopus_dev_password
POSTGRES_DB=octopus
DATABASE_URL=postgresql://octopus:octopus_dev_password@postgres:5432/octopus

REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me-in-production
ENCRYPTION_KEY=change-me-32-byte-minimum-production-key

# Optional AI provider adapter. Leave empty for rules-only mode.
AI_PROVIDER=
AI_API_KEY=

# Storage
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=octopus
OBJECT_STORAGE_ACCESS_KEY=octopus
OBJECT_STORAGE_SECRET_KEY=octopus_dev_secret
